; XP-Mx210BL controller-specific Bluetooth HID profile receive probe.
; This INF intentionally matches only the XP-Mx210BL's HID service + VID/PID.
; Do not broaden this match to the generic BTHENUM HID compatible ID.

[Version]
Signature="$WINDOWS NT$"
Class=Bluetooth
ClassGuid={e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider=%Provider%
DriverVer=11/25/2026,0.2.0.0
CatalogFile=XpMx210BL.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13
DriverCopy=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
XpMx210BL.sys=1

[Manufacturer]
%Manufacturer%=Models,NTamd64.10.0...16299

[Models.NTamd64.10.0...16299]
%DeviceDesc%=Install, BTHENUM\{00001124-0000-1000-8000-00805F9B34FB}_VID&00021949_PID&0402

[Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
XpMx210BL.sys

[Install.NT.Services]
AddService=XpMx210BL,0x00000002,ServiceInstall

[ServiceInstall]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\XpMx210BL.sys

[Install.NT.Wdf]
KmdfService=XpMx210BL,WdfSection

[WdfSection]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
Provider="DKMiner"
Manufacturer="DKMiner"
DiskName="XP-Mx210BL Bluetooth HID profile probe"
DeviceDesc="XP-Mx210BL Bluetooth HID Profile (Probe)"
ServiceDesc="XP-Mx210BL Bluetooth HID Profile Probe"
